# Generate with: bun -e 'console.log(crypto.randomUUID()+crypto.randomUUID())'
MCP_TOKEN=
DB_PATH=./data/newspulse.sqlite
HOST=127.0.0.1
PORT=3000
ALLOWED_HOSTS=localhost,127.0.0.1
# Browser-origin MCP clients must be explicitly allowlisted, comma separated.
ALLOWED_ORIGINS=

# Exact configured feed URLs permitted to extract same-origin private articles.
TRUSTED_PRIVATE_FEEDS=

# Optional: set both to enable verified inbound email and reconciliation.
RESEND_API_KEY=
RESEND_WEBHOOK_SECRET=

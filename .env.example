# Generate with: bun -e 'console.log(crypto.randomUUID()+crypto.randomUUID())'
MCP_TOKEN=
DB_PATH=./data/newspulse.sqlite
HOST=127.0.0.1
PORT=3000
ALLOWED_HOSTS=localhost,127.0.0.1
# Browser-origin MCP clients must be explicitly allowlisted, comma separated.
ALLOWED_ORIGINS=

# Exact configured feed URLs permitted to extract same-origin private articles.
TRUSTED_PRIVATE_FEEDS=

# Optional: API key plus webhook secret enable verified inbound email.
RESEND_API_KEY=
RESEND_WEBHOOK_SECRET=

# Optional outbound editions; enabling can send real email.
DELIVERY_ENABLED=false
DELIVERY_FROM=
DELIVERY_TO=
DELIVERY_TIMEZONE=Europe/London
DELIVERY_TIME=06:00

# Optional explicit GDELT discovery and profile-driven scheduling.
# Set conservative positive bounds in millionths of your billing currency.
DISCOVERY_DAILY_MICROS=
DISCOVERY_RUN_MICROS=
DISCOVERY_QUERY_MICROS=
# DISCOVERY_DAILY_QUERIES=10
# DISCOVERY_RUN_QUERIES=1
# DISCOVERY_DAILY_RESULTS=250
# DISCOVERY_RUN_RESULTS=25
# Scheduled discovery is disabled unless explicitly enabled. When enabled,
# it requires the budgets above and uses the same durable ledger as `discover`.
DISCOVERY_SCHEDULE_ENABLED=false
# DISCOVERY_SCHEDULE_HOURS=24
# DISCOVERY_ADJACENT_PERCENT=20
# Hacker News interest discovery is disabled unless explicitly enabled. It
# shares the discovery budgets above and needs no API key.
HN_DISCOVERY_ENABLED=false
# HN_DISCOVERY_HOURS=24
